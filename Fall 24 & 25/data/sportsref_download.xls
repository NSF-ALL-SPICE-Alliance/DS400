<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>
    
    

   
   <thead>      
      <tr>
         <th aria-label="Gm#" data-stat="team_game" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;strong&gt;Game Number&lt;/strong&gt;&lt;br&gt;Which game out of all played by this team.">Gm#</th>
         <th aria-label="Date" data-stat="date_game" scope="col" class=" poptip sort_default_asc center" data-tip="A number in parentheses indicates which game of a doubleheader.&lt;br&gt;Click dates for box scores of games or standings on this day.">Date</th>
         <th aria-label="" data-stat="boxscore" scope="col" class=" poptip sort_default_asc center"></th>
         <th aria-label="Tm" data-stat="team_ID" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center">Tm</th>
         <th aria-label="&nbsp;" data-stat="homeORvis" scope="col" class=" poptip sort_default_asc show_partial_when_sorting left" data-tip="&lt;strong&gt;Home or Away Game&lt;/strong&gt;&lt;br&gt;@ means it is an away game, blank means home.">&nbsp;</th>
         <th aria-label="Opp" data-stat="opp_ID" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center">Opp</th>
         <th aria-label="W/L" data-stat="win_loss_result" scope="col" class=" poptip show_partial_when_sorting center" data-tip="&lt;strong&gt;Win/Loss/Tie&lt;/strong&gt;&lt;br&gt;-wo indicates it was a walkoff win or loss. May miss some of those pre-1973, and none before 1940.">W/L</th>
         <th aria-label="Runs Scored" data-stat="R" scope="col" class=" poptip center" data-tip="Runs Scored/Allowed">R</th>
         <th aria-label="Runs Allowed" data-stat="RA" scope="col" class=" poptip center" data-tip="Runs Allowed">RA</th>
         <th aria-label="Inn" data-stat="extra_innings" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center" data-tip="&lt;strong&gt;Innings&lt;/strong&gt;&lt;br&gt;Only shown if something other than 9 innings were played.">Inn</th>
         <th aria-label="W-L" data-stat="win_loss_record" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center" data-tip="&lt;strong&gt;Win Loss Record&lt;/strong&gt;&lt;br&gt;Team&amp;#x2019;s overall record after this game.">W-L</th>
         <th aria-label="Rank" data-stat="rank" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center">Rank</th>
         <th aria-label="Games Back" data-stat="games_back" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;strong&gt;Games Back of Division/League Leader&lt;/strong&gt;&lt;br&gt;Computed as games over .500 of leader (W-L) minus games over .500 of team divided by two.&lt;br&gt;Typically computed at the end of play for a particular day.&lt;br&gt;Blank for 1st game of DH.">GB</th>
         <th aria-label="Win" data-stat="winning_pitcher" scope="col" class=" poptip sort_default_asc center">Win</th>
         <th aria-label="Loss" data-stat="losing_pitcher" scope="col" class=" poptip sort_default_asc center">Loss</th>
         <th aria-label="Save" data-stat="saving_pitcher" scope="col" class=" poptip sort_default_asc center">Save</th>
         <th aria-label="Time" data-stat="time_of_game" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Time of Game&lt;/strong&gt;">Time</th>
         <th aria-label="D/N" data-stat="day_or_night" scope="col" class=" poptip sort_default_asc center" data-tip="Day or Night Game&lt;br&gt;Determined by the start time of the game as stated by RetroSheet.&lt;br&gt;We rely on their designation here.">D/N</th>
         <th aria-label="Attendance" data-stat="attendance" scope="col" class=" poptip center" data-tip="&lt;strong&gt;Attendance&lt;/strong&gt;&lt;br&gt;Typically, tickets sold in home games.">Attendance</th>
         <th aria-label="cLI" data-stat="cli" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;Championship Leverage Index&lt;/strong&gt;&lt;br&gt;The importance of this game on the team's probability of winning the World Series (as calculated before the game).&lt;br&gt;1.0 is average importance, below 1.0 is below average importance and above 1.0 is above average importance." data-filter="1" data-name="cLI">cLI</th>
         <th aria-label="Streak" data-stat="win_loss_streak" scope="col" class=" poptip sort_default_asc show_partial_when_sorting center" data-tip="&lt;strong&gt;Win Loss Streak&lt;/strong&gt;&lt;br&gt;+ means a winning streak, - means a losing streak.">Streak</th>
         <th aria-label="Orig. Scheduled" data-stat="reschedule" scope="col" class=" poptip sort_default_asc center" data-tip="&lt;strong&gt;Originally Scheduled Game Date&lt;/strong&gt;&lt;br&gt;If this is a makeup game, the original game date. The reason for the reschedule is in parentheses.">Orig. Scheduled</th>
      </tr>
      </thead>
